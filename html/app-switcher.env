# Whether `autophys build-web` bundles the Lona family app switcher
# (html/app-switcher.json: its links and icons). `on` for the Lona-hosted
# builds (autophys.lona.so, dev--autophys.lona.so); `off` bundles none of
# them and the header shows no switcher. TENTO_APP_SWITCHER in the build's
# environment overrides this line, e.g. TENTO_APP_SWITCHER=off autophys build-web.
TENTO_APP_SWITCHER=on
