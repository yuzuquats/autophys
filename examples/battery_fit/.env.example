# Copy to .env (git-ignored); run.sh loads it. Nothing here is needed for the
# offline fit (./run.sh) or for `./run.sh agent ... --policy scripted` with a local workbook.

# Where investigations, proposals and approvals are recorded. Unset: a local
# workbook in ~/autophys. With a server, pair this device once: ./run.sh pair
# (the device key is saved in ~/.config/autophys/credentials, not here).
# AUTOPHYS_SERVER=http://127.0.0.1:4794

# The model that decides each step with `./run.sh agent start --policy model`.
# Baseten, or any OpenAI-compatible deployment:
# AUTOPHYS_REASON_ROUTE=baseten
# AUTOPHYS_REASON_URL=        # the deployment's OpenAI-compatible base URL (ends in /v1)
# AUTOPHYS_REASON_MODEL=      # the model name the deployment expects
# BASETEN_API_KEY=
#
# Meta (Muse Spark):
# AUTOPHYS_REASON_ROUTE=meta
# MODEL_API_KEY=
