std-settings-summary	content	# tento-ui-js/components/settings/settings-summary.ts
std-branch-graph	table-list	# Caller-supplied rows, lanes and marks; emits selection/toggle callbacks; no product state, route or fetch.
std-item-list	table-list	# Caller-supplied rows and selection; owns only virtual listbox presentation and keyboard focus.
std-item-row	table-list	# Caller-supplied text, medallion and selection; presents one sibling row and emits activation.
std-miniapp-action-bar	action	# Caller-supplied sections, labels and callbacks; owns floating toolbar presentation and toggle state, no domain model, route or transport.
