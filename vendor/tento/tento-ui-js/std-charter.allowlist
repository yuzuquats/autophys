# Evicted by a read, after passing every mechanical test:
#   std-docs-nav — the documentation site's navigation — a surface, not an object
#   std-shell-layout — an app shell: it slots a nav column and a docs body, so it names a SCREEN
#
# Permanent exceptions — vendor-mandated names, never flagged.
google-signin-button	# vendor-mandated
microsoft-signin-button	# vendor-mandated
std-rail-nav	navigation	# Sections and selection are supplied by the caller; clicks only call out.
std-library-collection-layout	layout	# Slot geometry only; no data or route ownership.
std-library-page-shell	layout	# Document-flow slots only; content and routing belong to callers.
std-library-search-mount	layout	# Reserves search geometry without reading or fetching application state.
std-library-item-presentation	overlay	# Presents caller-supplied DOM; dismissal and routing are caller-owned.
std-settings-body	layout	# tento-ui-js/components/settings/settings-body.ts
