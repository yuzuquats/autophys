            },
            {
              "key": "cadence",
              "position": "right",
              "min_width": 4,
              "align": "right",
              "priority": 2
            }
          ]
        }
      },
      "expected": [
        "fleet",
        "└── ✓ online",
        "    reachable",
        "       ├── checke…",
        "       └── cadenc…"
      ]
    },
    {
      "name": "branches carry their own column cell (caller-decides)",
      "input": {
        "kind": "tree",
        "term_width": 80,
        "tree": {
          "root": {
            "label": "fleet",
            "fields": {
              "checked_at": "—"
            },
            "children": [
              {
                "label": "yuzuquats",
                "fields": {
                  "checked_at": "2s ago"
                },
                "children": [
                  {
                    "label": "✓ online",
                    "fields": {
                      "checked_at": "1s ago",
                      "detail": "reachable"
                    }
                  }
                ]
              }
            ]
          },
          "columns": [
            {
              "key": "checked_at",
              "position": "left",
              "min_width": 8,
              "align": "right",
              "priority": 0
            },
            {
              "key": "detail",
              "position": "inline"
            }
          ]
        }
      },
      "expected": [
        "       — ▏ fleet",
        "  2s ago ▏ └── yuzuquats",
        "  1s ago ▏     └── ✓ online  reachable"
      ]
    },
    {
      "name": "divider drawn on wrapped continuation lines at width 36",
      "input": {
        "kind": "tree",
        "term_width": 36,
        "tree": {
          "root": {
            "label": "fleet",
            "children": [
              {
                "label": "✓ probe",
                "fields": {
                  "checked_at": "1s ago",
                  "detail": "responded in 12ms with payload size 2048 bytes"
                }
              }
            ]
          },
          "columns": [
            {
              "key": "checked_at",
