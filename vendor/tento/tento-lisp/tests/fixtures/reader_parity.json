{
  "_doc": "Alignment battery: each case asserts that its `posix`, `shell`, and/or `lisp` source reads into the canonical `sexpr` (a built, tagged-union JSON — never a parsed render). `posix` covers a simple statement through the compatibility reader; `shell` covers an operator-aware shell plan. When multiple forms are present they converge on the same s-expression; cases with only one form document an intentional asymmetry.",
  "cases": [
    {
      "desc": "bare command",
      "posix": "pwd",
      "lisp": "(std.sh.cmd \"pwd\")",
      "sexpr": {
        "list": [
          {
            "sym": "std.sh.cmd"
          },
          {
            "str": "pwd"
          }
        ]
      }
    },
    {
      "desc": "head symbol, flag + path args are string literals",
      "posix": "ls -la /tmp",
      "lisp": "(std.sh.cmd \"ls\" \"-la\" \"/tmp\")",
      "sexpr": {
        "list": [
          {
            "sym": "std.sh.cmd"
          },
          {
            "str": "ls"
          },
          {
            "str": "-la"
          },
          {
            "str": "/tmp"
          }
        ]
      }
    },
    {
      "desc": "bare unquoted $name uses runtime lookup and splitting",
      "posix": "cat $f",
      "lisp": "(std.sh.cmd \"cat\" (std.sh.split (list (list true (std.sh.var \"f\")))))",
      "sexpr": {
        "list": [
          {
            "sym": "std.sh.cmd"
          },
          {
            "str": "cat"
          },
          {
            "list": [
              {
                "sym": "std.sh.split"
              },
              {
                "list": [
                  {
                    "sym": "list"
                  },
                  {
                    "list": [
                      {
                        "sym": "list"
                      },
                      {
                        "bool": true
                      },
                      {
                        "list": [
                          {
                            "sym": "std.sh.var"
                          },
                          {
                            "str": "f"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "desc": "double-quoted $f expands without splitting",
      "posix": "echo \"$f\"",
      "lisp": "(std.sh.cmd \"echo\" (str.concat (std.sh.var \"f\")))",
      "sexpr": {
        "list": [
          {
            "sym": "std.sh.cmd"
          },
          {
            "str": "echo"
          },
          {
            "list": [
              {
                "sym": "str.concat"
