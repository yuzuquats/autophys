{
  "type": "drag-drop",
  "name": "deepNesting",
  "tree": {
    "0/nestable": {
      "1/nestable": {
        "2/nestable": {
          "3/nestable": {
            "4/nestable": {
              "5/nestable": {}
            }
          }
        }
      }
    },
    "6/nestable": {}
  },
  "cases": [
    {
      "name": "Dropped at (x=0, y=6",
      "input": { "start": 5, "movedTo": { "x": 0, "y": 6.5 } },
      "expected": {
        "validActions": [
          { "type": "nest", "idx": 6 }
        ]
      }
    },
    {
      "name": "Dropped at (x=3, y=3",
      "input": { "start": 6, "movedTo": { "x": 3, "y": 3.5 } },
      "expected": {
        "validActions": [
          { "type": "top", "idx": 4 }
        ]
      }
    },
    {
      "name": "Dropped at (x=1, y=1",
      "input": { "start": 3, "movedTo": { "x": 1, "y": 1.7 } },
      "expected": {
        "validActions": [
          { "type": "top", "idx": 2 }
        ]
      }
    },
    {
      "name": "Dropped at (x=4, y=4",
      "input": { "start": 0, "movedTo": { "x": 4, "y": 4.7 } },
      "expected": { "validActions": [] }
    },
    {
      "name": "Dropped at (x=4, y=4",
      "input": { "start": 5, "movedTo": { "x": 4, "y": 4.7 } },
      "expected": {
        "validActions": [
          { "type": "bottom", "idx": 4 }
        ]
      }
    },
    {
      "name": "Dropped at (x=5, y=4",
      "input": { "start": 5, "movedTo": { "x": 5, "y": 4.7 } },
      "expected": { "validActions": [] }
    },
    {
      "name": "Dropped at (x=6, y=4",
      "input": { "start": 5, "movedTo": { "x": 6, "y": 4.7 } },
      "expected": { "validActions": [] }
    },
    {
      "name": "Dropped at (x=5, y=4",
      "input": { "start": 2, "movedTo": { "x": 5, "y": 4.7 } },
      "expected": { "validActions": [] }
    },
    {
      "name": "Dropped at (x=5, y=4",
      "input": { "start": 6, "movedTo": { "x": 5, "y": 4.7 } },
      "expected": {
        "validActions": [
          { "type": "top", "idx": 5 }
        ]
      }
    },
    {
      "name": "valid parents",
      "input": {},
      "expected": {
        "0": { "top": ["root"], "bottom": ["0"] },
        "1": { "top": ["0"], "bottom": ["1"] },
        "2": { "top": ["1"], "bottom": ["2"] },
        "3": { "top": ["2"], "bottom": ["3"] },
        "4": { "top": ["3"], "bottom": ["4"] },
        "5": { "top": ["4"], "bottom": ["root", "0", "1", "2", "3", "4", "5"] },
        "6": { "top": ["root"], "bottom": ["root", "6"] }
      }
    }
  ]
}
