{
  "type": "canvas-hit-map",
  "name": "overlap",
  "description": "Overlapping cells — highest zIndex wins",
  "cases": [
    {
      "name": "higher zIndex wins when two cells overlap",
      "input": {
        "entries": [
          { "id": "behind", "rect": { "x": 0, "y": 0, "width": 100, "height": 96 }, "zIndex": 0 },
          { "id": "front", "rect": { "x": 20, "y": 24, "width": 80, "height": 48 }, "zIndex": 1 }
        ],
        "point": { "x": 50, "y": 40 }
      },
      "expected": { "id": "front", "region": "body" }
    },
    {
      "name": "hit behind cell in non-overlapping region",
      "input": {
        "entries": [
          { "id": "behind", "rect": { "x": 0, "y": 0, "width": 100, "height": 96 }, "zIndex": 0 },
          { "id": "front", "rect": { "x": 20, "y": 24, "width": 80, "height": 48 }, "zIndex": 1 }
        ],
        "point": { "x": 10, "y": 40 }
      },
      "expected": { "id": "behind", "region": "body" }
    },
    {
      "name": "zIndex order matters, not insertion order",
      "input": {
        "entries": [
          { "id": "high-z", "rect": { "x": 0, "y": 0, "width": 100, "height": 48 }, "zIndex": 5 },
          { "id": "low-z", "rect": { "x": 0, "y": 0, "width": 100, "height": 48 }, "zIndex": 1 }
        ],
        "point": { "x": 50, "y": 24 }
      },
      "expected": { "id": "high-z", "region": "body" }
    }
  ]
}
