/target
vendor/tento/node_modules
vendor/tento/Cargo.lock
vendor/tento/target/

# Optional contributor environments and local build output.
/.venv/
/.venv-train/

# Claude Code local agent config (may hold local permissions or secrets);
# shared skills under .claude/skills stay tracked.
.claude/*
!.claude/skills/

# Local issue notes (filed from field testing; not tracked).
/issues/

# Local experiment proposals (field-testing programme; not tracked).
/proposals/

# The packager's own build switches (html/.env.example lists them); never
# tracked, so a clone builds without the app switcher.
/html/.env
# The app switcher's manifest (tento-web's AppSwitcherPlugin format), supplied
# by a host that packages a switcher; a clone has none.
/html/app-switcher.json
# tento-web's bundler worker also loads a .env from its own directory.
/vendor/tento/tento-web/src/client/.env
