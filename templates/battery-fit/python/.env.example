# Copy to .env (git-ignored); closed_loop.py reads it. Nothing here is needed
# for the offline fit (battery_fit.py) or for `closed_loop.py ... --policy
# scripted` with a local workbook.

# Where investigations, proposals and approvals are recorded. Unset: a local
# workbook in ~/autophys. With a server, connect this device once:
# `autophys connect URL` (the device key is saved in
# ~/.config/autophys/credentials, not here).
# AUTOPHYS_SERVER=http://127.0.0.1:4794

# The model that decides each step with `closed_loop.py start --policy model`.
# Baseten, or any OpenAI-compatible deployment:
# AUTOPHYS_REASON_ROUTE=baseten
# AUTOPHYS_REASON_URL=        # the deployment's OpenAI-compatible base URL (ends in /v1)
# AUTOPHYS_REASON_MODEL=      # the model name the deployment expects
# BASETEN_API_KEY=
#
# Meta (Muse Spark):
# AUTOPHYS_REASON_ROUTE=meta
# MODEL_API_KEY=
