# autophys -> fine-tuned decision policy on Baseten.
# Fill the <...> values from train/sft/README.md "Deployment"; put your own key
# in BASETEN_API_KEY (never commit it). Load with:  set -a; . ./partner.env; set +a
AUTOPHYS_REASON_ROUTE=baseten
AUTOPHYS_REASON_URL=https://model-<MODEL_ID>.api.baseten.co/deployment/<DEPLOYMENT_ID>/sync/v1
AUTOPHYS_REASON_MODEL=<CHECKPOINT_NAME>
BASETEN_API_KEY=
# The SDK refuses live model calls without this (they cost money).
AUTOPHYS_ALLOW_LIVE_REASON=1
